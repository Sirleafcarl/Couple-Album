# Copy to /vol1/1000/gallery/.env on the NAS, NOT to the source repository.
GALLERY_ROOT=/vol1/1000/gallery
GALLERY_BIND_IP=192.168.1.100
GALLERY_PORT=8088
APP_ORIGIN=http://192.168.1.100:8088
# Generate using: openssl rand -hex 32
# Use hex to avoid URL escaping problems. Never reuse the development password.
POSTGRES_PASSWORD=
# LAN HTTP only. Enable after configuring HTTPS; do not expose HTTP to the internet.
SESSION_COOKIE_SECURE=false
